<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.CandidatesController.Candidates">
    <children>
        <TextField layoutX="30.0" layoutY="170.0" prefWidth="160.0" promptText="Número" />
        <TextField layoutX="30.0" layoutY="130.0" prefWidth="160.0" promptText="Sigla" />
        <TextField layoutX="30.0" layoutY="90.0" prefWidth="160.0" promptText="Nome" />
        <ComboBox layoutX="30.0" layoutY="210.0" prefWidth="160.0" promptText="Situação">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Ativo" />
                    <String fx:value="Inativo" />
                </FXCollections>
            </items>
        </ComboBox>
        <Button layoutX="30.0" layoutY="260.0" mnemonicParsing="false" prefHeight="24.0" prefWidth="160.0" text="Pesquisar Partido" />
        <TableView layoutX="210.0" layoutY="90.0" prefHeight="290.0" prefWidth="370.0">
            <columns>
                <TableColumn prefWidth="130.0" text="Nome" />
                <TableColumn prefWidth="70.0" text="Sigla" />
                <TableColumn prefWidth="70.0" text="Número" />
                <TableColumn prefWidth="98.0" text="Situação" />
            </columns>
        </TableView>
        <Button layoutY="2.0" mnemonicParsing="false" onAction="#AbrirMenuCandidato" text="Voltar" />
      <Label layoutX="238.0" layoutY="27.0" prefHeight="47.0" prefWidth="104.0" text="BUSCAR PARTIDO" />
    </children>
</AnchorPane>
