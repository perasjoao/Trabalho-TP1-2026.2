<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewControllers.CandidatesController.BuscarPartidoController">
    <children>
        <Label layoutX="250.0" layoutY="40.0" text="BUSCAR PARTIDO" />
        <TextField fx:id="campoNome" layoutX="30.0" layoutY="90.0" prefWidth="160.0" promptText="Nome" />
        <TextField fx:id="campoSigla" layoutX="30.0" layoutY="130.0" prefWidth="160.0" promptText="Sigla" />
        <TextField fx:id="campoNumero" layoutX="30.0" layoutY="170.0" prefWidth="160.0" promptText="Número" />
        <ComboBox fx:id="caixaSituacao" layoutX="30.0" layoutY="210.0" prefWidth="160.0" promptText="Situação" />
        <Button layoutX="30.0" layoutY="260.0" mnemonicParsing="false" onAction="#pesquisarPartido" prefHeight="24.0" prefWidth="160.0" text="Pesquisar Partido" />
        <Button layoutX="30.0" layoutY="295.0" mnemonicParsing="false" onAction="#limparFiltros" prefHeight="24.0" prefWidth="160.0" text="Limpar Filtros" />
        <TableView fx:id="tabelaPartidos" layoutX="210.0" layoutY="90.0" prefHeight="290.0" prefWidth="370.0">
            <columns>
                <TableColumn fx:id="colunaNome" prefWidth="130.0" text="Nome" />
                <TableColumn fx:id="colunaSigla" prefWidth="70.0" text="Sigla" />
                <TableColumn fx:id="colunaNumero" prefWidth="70.0" text="Número" />
                <TableColumn fx:id="colunaSituacao" prefWidth="98.0" text="Situação" />
            </columns>
        </TableView>
        <Button layoutY="2.0" mnemonicParsing="false" onAction="#AbrirMenuCandidato" text="Voltar" />
    </children>
</AnchorPane>