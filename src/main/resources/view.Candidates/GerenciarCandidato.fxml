<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewControllers.CandidatesController.Candidates">
   <children>
      <TextField layoutX="215.0" layoutY="112.0" promptText="Nome" />
      <TextField layoutX="215.0" layoutY="188.0" promptText="Numero" />
      <ComboBox layoutX="225.0" layoutY="242.0" prefHeight="24.0" prefWidth="150.0" promptText="Atualização">
          <items>
              <FXCollections fx:factory="observableArrayList">
                  <String fx:value="pré-candidato" />
                  <String fx:value="candidato" />
                  <String fx:value="candidatura inativa" />
                  <String fx:value="candidatura validada" />
              </FXCollections>
          </items>
      </ComboBox>
      <Button layoutX="227.0" layoutY="306.0" mnemonicParsing="false" text="Atualizar Candidato" />
       <Button layoutY="2.0" mnemonicParsing="false" onAction="#AbrirMenuCandidato" text="Voltar" />
      <Label layoutX="222.0" layoutY="57.0" text="ATUALIZAR CANDIDATO" />
   </children>
</AnchorPane>
