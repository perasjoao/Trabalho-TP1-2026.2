<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewControllers.CandidatesController.GerenciarCandidatoController">
    <children>
        <Label layoutX="222.0" layoutY="40.0" text="GERENCIAR CANDIDATO" />
        <ComboBox fx:id="caixaCandidatura" layoutX="150.0" layoutY="80.0" onAction="#selecionarCandidatura" prefWidth="300.0" promptText="Escolha a candidatura" />
        <TextField fx:id="campoNome" layoutX="215.0" layoutY="125.0" promptText="Nome" />
        <TextField fx:id="campoNumero" layoutX="215.0" layoutY="160.0" promptText="Número" />
        <ComboBox fx:id="caixaCargo" layoutX="215.0" layoutY="195.0" prefWidth="150.0" promptText="Cargo" />
        <ComboBox fx:id="caixaSituacao" layoutX="215.0" layoutY="230.0" prefWidth="150.0" promptText="Situação" />
        <Button layoutX="227.0" layoutY="290.0" mnemonicParsing="false" onAction="#atualizarCandidato" prefWidth="146.0" text="Atualizar Candidato" />
        <Button layoutX="227.0" layoutY="325.0" mnemonicParsing="false" onAction="#excluirCandidato" prefWidth="146.0" text="Excluir Candidato" />
        <Button layoutY="2.0" mnemonicParsing="false" onAction="#AbrirMenuCandidato" text="Voltar" />
    </children>
</AnchorPane>
