<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.CandidatesController.Candidates">
   <children>
      <TextField layoutX="202.0" layoutY="107.0" promptText="Nome" />
      <TextField layoutX="202.0" layoutY="154.0" promptText="Numero" />
      <TextField layoutX="202.0" layoutY="200.0" promptText="Cargo" />
      <ComboBox layoutX="213.0" layoutY="240.0" prefWidth="150.0" promptText="Situaçao">
      <items>
         <FXCollections fx:factory="observableArrayList">
            <String fx:value="pré-canditado" />
            <String fx:value="candidato" />
            <String fx:value="candidatura inativa" />
            <String fx:value="candidatura validada" />
         </FXCollections>
      </items>
      </ComboBox>
      <Button layoutY="2.0" mnemonicParsing="false" onAction="#AbrirMenuCandidato" text="Voltar" />
      <Button layoutX="212.0" layoutY="289.0" mnemonicParsing="false" text="Cadastrar Canditado" />
      <Label layoutX="197.0" layoutY="51.0" prefHeight="38.0" prefWidth="159.0" text="CADASTRO DE CANDIDATO" />
   </children>
</AnchorPane>
