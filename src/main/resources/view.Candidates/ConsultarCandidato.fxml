<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewControllers.CandidatesController.ConsultarCandidatoController">
    <children>
        <Label layoutX="220.0" layoutY="40.0" text="CONSULTA DE CANDIDATOS" />
        <TextField fx:id="campoNome" layoutX="30.0" layoutY="90.0" prefWidth="160.0" promptText="Nome" />
        <TextField fx:id="campoNumero" layoutX="30.0" layoutY="125.0" prefWidth="160.0" promptText="Número" />
        <ComboBox fx:id="caixaCargo" layoutX="30.0" layoutY="160.0" prefWidth="160.0" promptText="Cargo" />
        <ComboBox fx:id="caixaPartido" layoutX="30.0" layoutY="195.0" prefWidth="160.0" promptText="Partido" />
        <ComboBox fx:id="caixaPesquisa" layoutX="30.0" layoutY="230.0" prefWidth="160.0" promptText="Pesquisa" />
        <ComboBox fx:id="caixaSituacao" layoutX="30.0" layoutY="265.0" prefWidth="160.0" promptText="Situação" />
        <Button layoutX="30.0" layoutY="310.0" mnemonicParsing="false" onAction="#pesquisarCandidato" prefWidth="160.0" text="Pesquisar Candidato" />
        <Button layoutX="30.0" layoutY="345.0" mnemonicParsing="false" onAction="#limparFiltros" prefWidth="160.0" text="Limpar Filtros" />
        <TableView fx:id="tabelaCandidaturas" layoutX="210.0" layoutY="90.0" prefHeight="290.0" prefWidth="370.0">
            <columns>
                <TableColumn fx:id="colunaNome" prefWidth="90.0" text="Nome" />
                <TableColumn fx:id="colunaNumero" prefWidth="55.0" text="Número" />
                <TableColumn fx:id="colunaCargo" prefWidth="75.0" text="Cargo" />
                <TableColumn fx:id="colunaPartido" prefWidth="65.0" text="Partido" />
                <TableColumn fx:id="colunaSituacao" prefWidth="83.0" text="Situação" />
            </columns>
        </TableView>
        <Button layoutY="2.0" mnemonicParsing="false" onAction="#AbrirMenuCandidato" text="Voltar" />
    </children>
</AnchorPane>