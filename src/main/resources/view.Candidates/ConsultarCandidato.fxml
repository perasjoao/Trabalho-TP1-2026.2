<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.viewControllers.CandidatesController.ConsultarCandidatoController">
    <stylesheets>
        <URL value="@/styles/style.css" />
        <URL value="@/styles/Login-style.css" />
        <URL value="@/styles/ComparaPesquisa-style.css" />
        <URL value="@/styles/Admin-style.css" />
    </stylesheets>
    <children>
        <VBox spacing="14.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label maxWidth="1.7976931348623157E308" styleClass="titulo-topo" text="Consulta de Candidatos" />

                <HBox spacing="16.0" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="16.0" left="24.0" right="24.0" top="4.0" />
                    </padding>
                    <children>
                        <!-- Painel lateral de filtros -->
                        <VBox minWidth="220.0" prefWidth="230.0" spacing="8.0" styleClass="card-painel">
                            <children>
                                <Label styleClass="titulo-secao" text="Filtros de Consulta" />
                                <TextField fx:id="campoNome" promptText="Nome" styleClass="campo-texto" />
                                <TextField fx:id="campoNumero" promptText="Número" styleClass="campo-texto" />
                                <ComboBox fx:id="caixaCargo" maxWidth="1.7976931348623157E308" prefHeight="34.0" promptText="Cargo" />
                                <ComboBox fx:id="caixaPartido" maxWidth="1.7976931348623157E308" prefHeight="34.0" promptText="Partido" />
                                <ComboBox fx:id="caixaPesquisa" maxWidth="1.7976931348623157E308" prefHeight="34.0" promptText="Pesquisa" />
                                <ComboBox fx:id="caixaSituacao" maxWidth="1.7976931348623157E308" prefHeight="34.0" promptText="Situação" />
                                <VBox VBox.vgrow="ALWAYS" />
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#pesquisarCandidato" styleClass="botao-acao" text="Pesquisar Candidato" />
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#limparFiltros" styleClass="botao-secundario" text="Limpar Filtros" />
                            </children>
                        </VBox>

                        <!-- Painel principal: tabela de resultados -->
                        <VBox spacing="12.0" styleClass="card-painel" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="titulo-secao" text="Candidaturas Encontradas" />

                                <TableView fx:id="tabelaCandidaturas" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn fx:id="colunaNome" prefWidth="120.0" text="Nome" />
                                        <TableColumn fx:id="colunaNumero" prefWidth="60.0" text="Número" />
                                        <TableColumn fx:id="colunaCargo" prefWidth="90.0" text="Cargo" />
                                        <TableColumn fx:id="colunaPartido" prefWidth="70.0" text="Partido" />
                                        <TableColumn fx:id="colunaSituacao" prefWidth="90.0" text="Situação" />
                                    </columns>
                                </TableView>

                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#AbrirMenuCandidato" styleClass="botao-secundario" text="Voltar" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
