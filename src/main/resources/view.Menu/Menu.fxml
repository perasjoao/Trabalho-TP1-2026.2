<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" stylesheets="@/styles/style.css"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.viewControllers.MenuController.Menu">
   <children>
      <VBox alignment="TOP_CENTER" spacing="16.0"
            AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" styleClass="caixaTitulo">
         <children> <!-- vbox é tipo uma div-->
            <Label maxWidth="1.7976931348623157E308" styleClass="titulo-topo" text="Menu Principal" />

            <!-- Container centralizado para os botões -->
            <VBox alignment="CENTER" spacing="14.0" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets bottom="30.0" left="20.0" right="20.0" top="10.0" />
               </padding>
               <children>
                  <Button fx:id="botaoAdm" mnemonicParsing="false" onAction="#AbrirAdm" styleClass="botao" text="Administração" />
                  <Button fx:id="botaoPesquisa" mnemonicParsing="false" onAction="#AbrirPesquisas" styleClass="botao" text="Pesquisas" />
                  <Button fx:id="botaoColeta" mnemonicParsing="false" onAction="#AbrirColeta" styleClass="botao" text="Coleta" />
                  <Button fx:id="botaoAnalise" mnemonicParsing="false" onAction="#AbrirAnalise" styleClass="botao" text="Análise Estatística" />
                  <Button fx:id="botaoCandidato" mnemonicParsing="false" onAction="#AbrirCandidatos" styleClass="botao" text="Candidatos e Partidos" />
                  <Button mnemonicParsing="false" onAction="#sair" styleClass="botao" style="-fx-background-color: #c62828;" text="Sair" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>