                        <CheckBox fx:id="chkSituacaoEmColeta" text="Em coleta" />
                        <CheckBox fx:id="chkSituacaoEncerrada" text="Encerrada" />
                        <CheckBox fx:id="chkSituacaoProcessada" text="Processada" />

                        <Separator />
                        <Label style="-fx-font-weight: bold;" text="Período (início - fim):" />
                        <DatePicker fx:id="dpDataInicio" promptText="Data início" />
                        <DatePicker fx:id="dpDataFim" promptText="Data fim" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <Button layoutX="45.0" layoutY="542.0" mnemonicParsing="false" onAction="#filtrarPesquisas" prefWidth="85.0" text="Filtrar" />
        <Button layoutX="145.0" layoutY="542.0" mnemonicParsing="false" onAction="#limparFiltros" prefWidth="85.0" text="Limpar" />

        <TableView fx:id="tblPesquisas" layoutX="271.0" layoutY="80.0" prefHeight="340.0" prefWidth="572.0">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="65.0" text="Código" />
                <TableColumn fx:id="colNome" prefWidth="115.0" text="Nome" />
                <TableColumn fx:id="colTipo" prefWidth="85.0" text="Tipo" />
                <TableColumn fx:id="colRegiao" prefWidth="80.0" text="Região" />
