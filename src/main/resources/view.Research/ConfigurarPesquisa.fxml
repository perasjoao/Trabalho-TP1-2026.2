<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="580.0" prefWidth="880.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.viewControllers.ResearchController.ConfigurarPesquisaController">
    <stylesheets>
        <URL value="@/styles/style.css" />
        <URL value="@/styles/Login-style.css" />
        <URL value="@/styles/ComparaPesquisa-style.css" />
        <URL value="@/styles/Relatorio-style.css" />
        <URL value="@/styles/Admin-style.css" />
    </stylesheets>
    <children>
        <VBox spacing="14.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label maxWidth="1.7976931348623157E308" styleClass="titulo-topo" text="Configurar Pesquisa" />

                <VBox spacing="14.0" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="18.0" left="28.0" right="28.0" top="4.0" />
                    </padding>
                    <children>
                        <!-- Barra de Seleção da Pesquisa -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card-painel">
                            <children>
                                <Label styleClass="label-campo" text="Pesquisa selecionada:" />
                                <ComboBox fx:id="cbPesquisa" onAction="#aoSelecionarPesquisa" prefHeight="36.0" prefWidth="380.0" promptText="Selecione a pesquisa" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
                            </children>
                        </HBox>

                        <!-- Abas de Configuração -->
                        <VBox styleClass="card-painel" VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                                    <tabs>
                                        <!-- RF 4: perguntas e opcoes de resposta -->
                                        <Tab text="Perguntas">
                                            <content>
                                                <HBox spacing="16.0">
                                                    <padding>
                                                        <Insets bottom="12.0" left="10.0" right="10.0" top="14.0" />
                                                    </padding>
                                                    <children>
                                                        <VBox prefWidth="285.0" spacing="10.0">
                                                            <children>
                                                                <Label styleClass="titulo-secao" text="Nova / Editar Pergunta" />
                                                                <TextField fx:id="txtEnunciadoPergunta" promptText="Texto da pergunta" styleClass="campo-texto" />
                                                                <ComboBox fx:id="cbTipoPergunta" maxWidth="1.7976931348623157E308" prefHeight="36.0" promptText="Tipo de pergunta" />

                                                                <HBox spacing="6.0">
                                                                    <children>
                                                                        <TextField fx:id="txtNovaOpcao" promptText="Opção de resposta" styleClass="campo-texto" HBox.hgrow="ALWAYS" />
                                                                        <Button mnemonicParsing="false" onAction="#adicionarOpcao" styleClass="botao-acao" text="+" />
                                                                        <Button mnemonicParsing="false" onAction="#removerOpcao" styleClass="botao-secundario" text="-" />
                                                                    </children>
                                                                </HBox>

                                                                <ListView fx:id="listOpcoes" prefHeight="120.0" VBox.vgrow="ALWAYS" />

                                                                <HBox spacing="8.0">
                                                                    <children>
                                                                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#adicionarPergunta" styleClass="botao-acao" text="Adicionar" HBox.hgrow="ALWAYS" />
                                                                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#editarPergunta" styleClass="botao-secundario" text="Editar" HBox.hgrow="ALWAYS" />
                                                                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#excluirPergunta" style="-fx-background-color: #fee2e2; -fx-text-fill: #b91c1c; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 8 10; -fx-cursor: hand;" text="Excluir" HBox.hgrow="ALWAYS" />
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </VBox>

                                                        <TableView fx:id="tblPerguntas" HBox.hgrow="ALWAYS">
                                                            <columnResizePolicy>
                                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                            </columnResizePolicy>
                                                            <columns>
                                                                <TableColumn fx:id="colNumPergunta" prefWidth="50.0" text="Nº" />
                                                                <TableColumn fx:id="colTextoPergunta" prefWidth="210.0" text="Pergunta" />
                                                                <TableColumn fx:id="colTipoPergunta" prefWidth="95.0" text="Tipo" />
                                                                <TableColumn fx:id="colOpcoesPergunta" prefWidth="125.0" text="Opções" />
                                                            </columns>
                                                        </TableView>
                                                    </children>
                                                </HBox>
                                            </content>
                                        </Tab>

                                        <!-- RF 5: regioes da pesquisa -->
                                        <Tab text="Regiões">
                                            <content>
                                                <HBox alignment="CENTER" spacing="18.0">
                                                    <padding>
                                                        <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                                                    </padding>
                                                    <children>
                                                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label styleClass="titulo-secao" text="Regiões disponíveis" />
                                                                <ListView fx:id="listRegioesDisponiveis" VBox.vgrow="ALWAYS" />
                                                            </children>
                                                        </VBox>

                                                        <VBox alignment="CENTER" spacing="10.0">
                                                            <children>
                                                                <Button mnemonicParsing="false" onAction="#associarRegiao" prefWidth="115.0" styleClass="botao-acao" text="Associar &gt;" />
                                                                <Button mnemonicParsing="false" onAction="#removerRegiao" prefWidth="115.0" styleClass="botao-secundario" text="&lt; Remover" />
                                                            </children>
                                                        </VBox>

                                                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label styleClass="titulo-secao" text="Regiões da pesquisa" />
                                                                <ListView fx:id="listRegioesAssociadas" VBox.vgrow="ALWAYS" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                            </content>
                                        </Tab>

                                        <!-- RF 6: candidatos da pesquisa -->
                                        <Tab text="Candidatos">
                                            <content>
                                                <HBox alignment="CENTER" spacing="18.0">
                                                    <padding>
                                                        <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                                                    </padding>
                                                    <children>
                                                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label styleClass="titulo-secao" text="Candidatos disponíveis" />
                                                                <ListView fx:id="listCandidatosDisponiveis" VBox.vgrow="ALWAYS" />
                                                            </children>
                                                        </VBox>

                                                        <VBox alignment="CENTER" spacing="10.0">
                                                            <children>
                                                                <Button mnemonicParsing="false" onAction="#associarCandidato" prefWidth="115.0" styleClass="botao-acao" text="Associar &gt;" />
                                                                <Button mnemonicParsing="false" onAction="#removerCandidato" prefWidth="115.0" styleClass="botao-secundario" text="&lt; Remover" />
                                                            </children>
                                                        </VBox>

                                                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label styleClass="titulo-secao" text="Candidatos da pesquisa" />
                                                                <ListView fx:id="listCandidatosAssociados" VBox.vgrow="ALWAYS" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                            </content>
                                        </Tab>
                                    </tabs>
                                </TabPane>
                            </children>
                        </VBox>

                        <!-- Rodapé -->
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#voltarParaGerenciar" styleClass="botao-secundario" text="Voltar" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button mnemonicParsing="false" onAction="#salvarConfiguracao" styleClass="botao-acao" text="Salvar configuração" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>