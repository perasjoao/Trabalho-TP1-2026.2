<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.AnaliseController.AnaliseController">
   <children>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label text="Processar Pesquisa">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <ComboBox prefWidth="200.0" promptText="Selecione a pesquisa" />
            <Label text="Situação: -" />
            <HBox alignment="CENTER" prefHeight="100.0" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" text="Processar" />
                  <Button mnemonicParsing="false" onAction="#abrirMenuAnalise" text="Voltar" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
