<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewControllers.AnaliseController.AnaliseController">
   <children>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label text="Relatórios">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <ComboBox prefWidth="130.0" promptText="Pesquisa" />
                  <ComboBox prefWidth="130.0" promptText="Região" />
                  <ComboBox prefWidth="130.0" promptText="Candidato" />
                  <DatePicker prefWidth="130.0" promptText="Data inicial" />
                  <DatePicker prefWidth="130.0" promptText="Data final" />
               </children>
            </HBox>
            <!-- filtros por caracteristicas da amostra -->
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <ComboBox prefWidth="130.0" promptText="Faixa Etária" />
                  <ComboBox prefWidth="130.0" promptText="Escolaridade" />
                  <ComboBox prefWidth="130.0" promptText="Gênero" />
                  <ComboBox prefWidth="130.0" promptText="Faixa de Renda" />
               </children>
            </HBox>
            <Button mnemonicParsing="false" text="Gerar Relatório" />
            <TableView maxWidth="500.0" prefHeight="200.0" prefWidth="200.0">
              <columns>
                <TableColumn prefWidth="75.0" text="Opção" />
                <TableColumn prefWidth="75.0" text="Quantidade" />
                  <TableColumn prefWidth="75.0" text="\%" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" text="Exportar PDF" />
                  <Button mnemonicParsing="false" text="Exportar CSV" />
               </children>
            </HBox>
            <Button mnemonicParsing="false" onAction="#abrirMenuAnalise" text="Voltar" />
         </children>
      </VBox>
   </children>
</AnchorPane>
