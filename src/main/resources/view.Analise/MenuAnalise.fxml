<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewControllers.AnaliseController.AnaliseController">
   <children>
      <VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label text="Análise Estatística" textAlignment="CENTER">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <Button mnemonicParsing="false" onAction="#abrirProcessarPesquisa" prefWidth="200.0" text="Processar Pesquisa" />
            <Button mnemonicParsing="false" onAction="#abrirResultados" prefWidth="200.0" text="Resultados Estatísticos" />
            <Button mnemonicParsing="false" onAction="#abrirCompararPesquisas" prefWidth="200.0" text="Comparar Pesquisas" />
            <Button mnemonicParsing="false" onAction="#abrirRelatorios" prefWidth="200.0" text="Relatórios" />
            <Button mnemonicParsing="false" onAction="#voltarMenuPrincipal" prefWidth="200.0" text="Voltar" />
         </children>
      </VBox>
   </children>
</AnchorPane>
