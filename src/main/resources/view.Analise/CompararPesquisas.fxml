<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>

<?import javax.print.DocFlavor.URL?>
<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.viewControllers.AnaliseController.AnaliseController">
    <stylesheets>
        <URL value="@/styles/style.css" />
        <URL value="@/styles/ComparaPesquisa-style.css" />
    </stylesheets>
    <children>
        <VBox alignment="TOP_CENTER" spacing="16.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label maxWidth="1.7976931348623157E308" styleClass="titulo-topo" text="Comparar Pesquisas" />

                <VBox alignment="CENTER" spacing="20.0" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="25.0" left="30.0" right="30.0" top="10.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <ComboBox fx:id="caixaPesquisaA" prefHeight="40.0" prefWidth="200.0" promptText="Pesquisa A" />
                                <ComboBox fx:id="caixaPesquisaB" prefHeight="40.0" prefWidth="200.0" promptText="Pesquisa B" />
                                <Button mnemonicParsing="false" onAction="#acaoCompararPesquisas" styleClass="botao-acao" text="Comparar" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER" spacing="25.0" VBox.vgrow="ALWAYS">
                            <children>
                                <TableView fx:id="tabelaComparacao" maxHeight="550.0" prefHeight="780.0" prefWidth="900.0">
                                    <columns>
                                        <TableColumn fx:id="colCompOpcao" prefWidth="900.0" text="Opção" />
                                        <TableColumn fx:id="colCompPesquisaA" prefWidth="305.0" text="\% Pesquisa A" />
                                        <TableColumn fx:id="colCompPesquisaB" prefWidth="305.0" text="\% Pesquisa B" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                                <BarChart fx:id="graficoComparacao" maxHeight="620.0" prefHeight="280.0" prefWidth="750.0" title="Comparação entre pesquisas">
                                    <xAxis>
                                        <CategoryAxis label="Candidato" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis label="\%" side="LEFT" />
                                    </yAxis>
                                </BarChart>
                            </children>
                        </HBox>

                        <Button mnemonicParsing="false" onAction="#abrirMenuAnalise" styleClass="botao-voltar" text="Voltar" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>