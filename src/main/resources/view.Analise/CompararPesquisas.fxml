<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.AnaliseController.AnaliseController">
   <children>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label text="Comparar Pesquisas">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <ComboBox prefWidth="150.0" promptText="Pesquisa A" />
                  <ComboBox prefWidth="150.0" promptText="Pesquisa B" />
                  <Button mnemonicParsing="false" prefWidth="150.0" text="Comparar" />
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="15.0">
               <children>
                  <TableView prefHeight="200.0" prefWidth="250.0">
                    <columns>
                      <TableColumn prefWidth="75.0" text="Opção" />
                      <TableColumn prefWidth="75.0" text="\% Pesquisa A" />
                        <TableColumn prefWidth="75.0" text="\% Pesquisa B" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <BarChart title="Comparação entre pesquisas">
                    <xAxis>
                      <CategoryAxis label="Candidato" />
                    </xAxis>
                    <yAxis>
                      <NumberAxis label="\%" side="LEFT" />
                    </yAxis>
                  </BarChart>
               </children>
            </HBox>
            <Button mnemonicParsing="false" onAction="#abrirMenuAnalise" text="Voltar" />
         </children>
      </VBox>
   </children>
</AnchorPane>
