<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ColetaController.ColetaController">
   <children>
      <VBox alignment="CENTER" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label text="Coleta e Amostra">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <Button mnemonicParsing="false" onAction="#ConfigAm" prefWidth="200.0" text="Configurar Amostra" />
            <Button mnemonicParsing="false" onAction="#ProxPesquisa" prefWidth="200.0" text="Registrar Respostas" />
            <Button mnemonicParsing="false" onAction="#abrirFiltroEntrevistas" prefWidth="200.0" text="Consultar Entrevistas" />
            <Button mnemonicParsing="false" onAction="#voltarMenuPrincipal" prefWidth="200.0" text="Voltar" />
         </children>
      </VBox>
   </children>
</AnchorPane>
